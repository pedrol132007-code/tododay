# Variáveis do instalador desktop (npm run desktop:build). Copie para .env.desktop.
# Use o projeto de PRODUÇÃO (tododay-prod): o que estiver aqui fica embutido no instalador.
VITE_SUPABASE_URL=https://SEU-PROJETO-PROD.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Endereço da versão web na Vercel. Links de convite e de e-mail gerados no desktop apontam para cá.
VITE_PUBLIC_URL=https://SEU-APP.vercel.app
