# Supabase: Project Settings → API. Use a chave anon/publishable, nunca a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Só para testes de ponta a ponta (npm run test:e2e), sempre no projeto de DEV.
# Conexão Postgres: Project Settings → Database → Connection string (pooler).
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
E2E_EMAIL=e2e@tododay.test
E2E_PASSWORD=uma-senha-qualquer
