# Copie para .env (que o git ignora) e preencha. Nunca coloque valores reais neste arquivo.
#
# Ambientes: o app sabe em qual está pelo projeto em VITE_SUPABASE_URL (src/lib/environment.ts).
#   - Desenvolvimento (este .env, os previews da Vercel): projeto tododay-dev. Mostra o selo "Dev"
#     e o botão da demonstração.
#   - Produção (variáveis "Production" da Vercel, .env.desktop): projeto tododay-prod. Sem selo,
#     sem demonstração.

# Supabase de DEV: Project Settings → API. Use a chave anon/publishable, nunca a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO-DEV.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Só para testes de ponta a ponta (npm run test:e2e), sempre no projeto de DEV (o seed recusa produção).
# Conexão Postgres: Project Settings → Database → Connection string (pooler).
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO-DEV:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
E2E_EMAIL=e2e@tododay.test
E2E_PASSWORD=uma-senha-qualquer
# Sentry (opcional): DSN do projeto, é público. Vazio = não envia erros.
VITE_SENTRY_DSN=
