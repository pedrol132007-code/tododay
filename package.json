{
  "name": "tododay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:build": "tauri build --config src-tauri/tauri.desktop.conf.json",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test -c playwright.mock.config.ts",
    "gen:function": "node scripts/gen-attachments-function.mjs",
    "check:prod": "node scripts/check-prod.mjs",
    "lint": "eslint .",
    "gen:setup": "node scripts/gen-setup.mjs",
    "admin:primeiro": "node --use-system-ca scripts/primeiro-admin.mjs",
    "auth:configurar": "node --use-system-ca scripts/configurar-auth.mjs",
    "test:e2e:csp": "playwright test -c playwright.csp.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "^5.59.0",
    "@tauri-apps/api": "^2.1.1",
    "framer-motion": "^11.11.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.9",
    "vitest": "^3.2.7"
  }
}
